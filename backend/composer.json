{
    "name": "fulll/backend",
    "description": "Fulll technical test — Vehicle fleet parking management",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "symfony/console": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Fulll\\Backend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulll\\Backend\\Tests\\": "tests/",
            "Fulll\\Tests\\Behat\\": "features/bootstrap/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "phpunit": "phpunit",
        "behat": "behat --strict",
        "smoke": "sh tests/cli-smoke.sh",
        "test": [
            "@phpunit",
            "@behat",
            "@smoke"
        ],
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "db:schema": "psql -v ON_ERROR_STOP=1 -q -f schema.sql"
    },
    "require-dev": {
        "behat/behat": "^3.34",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
