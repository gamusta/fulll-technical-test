{
    "name": "fulll/backend",
    "description": "Fulll technical test — Vehicle fleet parking management",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Fulll\\Backend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulll\\Tests\\Behat\\": "features/bootstrap/"
        }
    },
    "scripts": {
        "behat": "behat --strict",
        "test": "@behat",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "db:schema": "psql -v ON_ERROR_STOP=1 -q -f schema.sql"
    },
    "require-dev": {
        "behat/behat": "^3.34",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3"
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.3.0" }
    }
}
